{
  "name": "fiddler",
  "version": "1.0.3",
  "description": "Electron app",
  "main": "main.js",
  "productName": "Fiddler",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^27.0.0"
  },
  "build": {
    "appId": "com.joseph.fiddler",
    "productName": "Fiddler",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "Fiddler",
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "directories": {
      "output": ""
    }
  }
}
