{
  "name": "fiddler",
  "version": "1.0.4",
  "description": "Electron app",
  "main": "main.js",
  "productName": "Fiddler",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^27.0.0"
  },
  "build": {
    "appId": "com.joseph.fiddler",
    "productName": "Fiddler",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Fiddler",
      "window": {
        "width": 660,
        "height": 400
      },
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "proxy.js",
      "logger.js",
      "index.html",
      "package.json",
      "!**/*.dmg",
      "!**/*.blockmap",
      "!dist",
      "!mac-arm64",
      "!build",
      "!test-proxy.js",
      "!.claude-memory",
      "!builder-debug.yml",
      "!builder-effective-config.yaml"
    ]
  }
}
